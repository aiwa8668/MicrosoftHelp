# ==============================
# WebChat 运行模式
# ==============================
WEBCHAT_BACKEND=local
WEBCHAT_USER_ID=web-user
WEBCHAT_USER_NAME=Web User
WEBCHAT_PUBLIC_BASE_URL=https://help.example.com
WEBCHAT_UPLOAD_RETENTION_DAYS=10
WEBCHAT_UPLOADS_ENABLED=false
WEBCHAT_UPLOAD_BUTTON_VISIBLE=false

# ==============================
# Copilot Studio Direct Line
# WEBCHAT_BACKEND=directline 时使用
# ==============================
COPILOT_STUDIO_DIRECTLINE_TOKEN_ENDPOINT=
DIRECTLINE_BASE_URL=https://directline.botframework.com/v3/directline

# ==============================
# Copilot Studio Conversations API
# WEBCHAT_BACKEND=copilotstudio 时使用
# ==============================
COPILOT_STUDIO_CONVERSATIONS_URL=
COPILOT_STUDIO_TOKEN_MODE=raw
COPILOT_STUDIO_BEARER_TOKEN=
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_SCOPE=

# ==============================
# FAQ 后台与会话安全
# ==============================
FAQ_ADMIN_USERNAME=admin
FAQ_ADMIN_PASSWORD=
FAQ_LOG_RETENTION_DAYS=30
FAQ_SESSION_SECRET=

# ==============================
# Microsoft Entra ID（全球版）
# CLIENT_ID 与 CLIENT_SECRET 同时存在时启用
# ==============================
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations
ENTRA_REDIRECT_URI=
ENTRA_SCOPES=https://graph.microsoft.com/User.Read
ENTRA_SESSION_SECRET=

# ==============================
# Microsoft Entra ID（世纪互联）
# CLIENT_ID 与 CLIENT_SECRET 同时存在时启用
# ==============================
ENTRA_CHINA_CLIENT_ID=
ENTRA_CHINA_CLIENT_SECRET=
ENTRA_CHINA_AUTHORITY=https://login.partner.microsoftonline.cn/organizations
ENTRA_CHINA_REDIRECT_URI=
ENTRA_CHINA_SCOPES=https://microsoftgraph.chinacloudapi.cn/User.Read
